{"response": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Resume Extraction</title>\n<style>\n  :root {\n    --bg: #f7f7f5;\n    --fg: #1a1a1a;\n    --muted: #555;\n    --card: #ffffff;\n    --border: #e2e2df;\n    --accent: #2b5fd9;\n    --code-bg: #0f172a;\n    --code-fg: #e2e8f0;\n    --code-key: #7dd3fc;\n    --code-str: #86efac;\n    --code-num: #fca5a5;\n  }\n  @media (prefers-color-scheme: dark) {\n    :root {\n      --bg: #121216;\n      --fg: #ececec;\n      --muted: #a0a0a8;\n      --card: #1c1c22;\n      --border: #2c2c33;\n      --accent: #7ea8ff;\n    }\n  }\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    background: var(--bg);\n    color: var(--fg);\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n    line-height: 1.55;\n  }\n  main {\n    max-width: 820px;\n    margin: 0 auto;\n    padding: 32px 20px 64px;\n  }\n  h1 {\n    font-size: 1.6rem;\n    margin: 0 0 4px;\n  }\n  h2 {\n    font-size: 1.1rem;\n    margin: 28px 0 10px;\n    color: var(--accent);\n  }\n  p.lede {\n    color: var(--muted);\n    margin: 0 0 24px;\n  }\n  section.card {\n    background: var(--card);\n    border: 1px solid var(--border);\n    border-radius: 10px;\n    padding: 18px 20px;\n    margin-bottom: 20px;\n  }\n  pre {\n    background: var(--code-bg);\n    color: var(--code-fg);\n    padding: 16px;\n    border-radius: 8px;\n    overflow-x: auto;\n    font-family: \"SF Mono\", Menlo, Consolas, monospace;\n    font-size: 0.92rem;\n    line-height: 1.5;\n    margin: 0;\n  }\n  .k { color: var(--code-key); }\n  .s { color: var(--code-str); }\n  .n { color: var(--code-num); }\n  ul.summary {\n    margin: 8px 0 0;\n    padding-left: 20px;\n  }\n  ul.summary li { margin: 4px 0; }\n  .task {\n    font-size: 0.95rem;\n    color: var(--muted);\n  }\n</style>\n</head>\n<body>\n<main>\n  <h1>Resume Extraction</h1>\n  <p class=\"lede\">Structured data extracted from Alex Chen's resume.</p>\n\n  <section class=\"card\">\n    <h2>Task</h2>\n    <p class=\"task\">Extract information from a resume into a JSON object with fields: <code>name</code>, <code>years_experience</code>, <code>skills</code>, and <code>most_recent_role</code> (title, company, dates).</p>\n  </section>\n\n  <section class=\"card\">\n    <h2>Extracted JSON</h2>\n<pre><code>{\n  <span class=\"k\">\"name\"</span>: <span class=\"s\">\"Alex Chen\"</span>,\n  <span class=\"k\">\"years_experience\"</span>: <span class=\"n\">9</span>,\n  <span class=\"k\">\"skills\"</span>: [\n    <span class=\"s\">\"Go\"</span>,\n    <span class=\"s\">\"Python\"</span>,\n    <span class=\"s\">\"TypeScript\"</span>,\n    <span class=\"s\">\"Node.js\"</span>,\n    <span class=\"s\">\"Kafka\"</span>,\n    <span class=\"s\">\"Flink\"</span>,\n    <span class=\"s\">\"Postgres\"</span>,\n    <span class=\"s\">\"Redis\"</span>,\n    <span class=\"s\">\"Kubernetes\"</span>,\n    <span class=\"s\">\"Terraform\"</span>,\n    <span class=\"s\">\"AWS (EKS, RDS, Lambda)\"</span>,\n    <span class=\"s\">\"gRPC\"</span>,\n    <span class=\"s\">\"REST\"</span>,\n    <span class=\"s\">\"distributed tracing\"</span>,\n    <span class=\"s\">\"on-call\"</span>\n  ],\n  <span class=\"k\">\"most_recent_role\"</span>: {\n    <span class=\"k\">\"title\"</span>: <span class=\"s\">\"Staff Software Engineer\"</span>,\n    <span class=\"k\">\"company\"</span>: <span class=\"s\">\"Northwind Health\"</span>,\n    <span class=\"k\">\"dates\"</span>: <span class=\"s\">\"Mar 2023 to present\"</span>\n  }\n}</code></pre>\n  </section>\n\n  <section class=\"card\">\n    <h2>Summary</h2>\n    <ul class=\"summary\">\n      <li><strong>Candidate:</strong> Alex Chen</li>\n      <li><strong>Experience:</strong> 9 years</li>\n      <li><strong>Current role:</strong> Staff Software Engineer at Northwind Health (Mar 2023 to present)</li>\n      <li><strong>Skill count:</strong> 15</li>\n    </ul>\n  </section>\n</main>\n</body>\n</html>"}
